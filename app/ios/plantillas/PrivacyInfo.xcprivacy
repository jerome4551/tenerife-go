<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tenerife Go · el manifiesto de privacidad de la app (Apple lo pide en el
     paquete). Dice lo mismo que la politica de privacidad de la app
     (idiomas/privacidad/es.json, privacidad.html), apartado por apartado:
       · Cuenta (opcional): correo y contrasena, en Supabase      -> correo, id de usuario (ligados a la cuenta)
       · Favoritos: con cuenta se sincronizan                      -> «otro contenido del usuario» (ligado a la cuenta)
       · Geolocalizacion: las coordenadas de origen y destino van
         al servicio de rutas; las del lugar, al del tiempo        -> ubicacion precisa (sin ligar a nadie)
       · Nominatim: el texto que escribes al buscar una direccion  -> historial de busqueda (sin ligar)
     Google Analytics no va en la app (22 de octubre de 2026): con la marca
     TGO_NATIVO, index.html ni lo configura ni lo carga, y el aviso de
     cookies no sale (lo miran app_preparar.js y probar_app.js); la politica
     lo dice (ppStatsTienda). Solo esta en la web, asi que aqui no hay
     analitica: ni uso, ni ubicacion aproximada, ni identificador.
     Sin rastreo (NSPrivacyTracking false): ninguna red publicitaria, sin el
     identificador publicitario (IDFA). La camara y los sensores no salen del
     movil (la politica lo dice), asi que no son datos recogidos.
     Los avisos push de la web no existen dentro de la app (WKWebView).
     NSPrivacyAccessedAPITypes va vacio: el codigo propio de la app (la
     plantilla de Capacitor) no llama a ninguna de las API con motivo
     obligatorio; las de Capacitor las declara su propio manifiesto. -->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePreciseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeSearchHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
