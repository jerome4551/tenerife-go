# Tenerife Go para la App Store, sin Mac (LANZAMIENTO-APP-STORE.md §9).
# Lo corre GitHub Actions en un runner macOS (.github/workflows/app-store.yml);
# tambien vale en un Mac cualquiera con `bundle exec fastlane ios <carril>`.
#
# Secretos (variables de entorno) que hacen falta:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8   la clave API de App Store Connect (Users and Access → Integrations)
#   APPLE_TEAM_ID                           el Team ID (developer.apple.com/account → Membership details)
#   MATCH_GIT_URL, MATCH_GIT_BASIC_AUTHORIZATION, MATCH_PASSWORD
#                                           el repositorio privado donde match guarda el certificado y el perfil,
#                                           cifrados; la autorizacion es base64("usuario:token") de un token de GitHub
#                                           (en el workflow la calcula el paso, del secreto MATCH_GIT_TOKEN tal cual)
#   ASC_REVIEW_NAME, ASC_REVIEW_PHONE, ASC_REVIEW_EMAIL   (solo para `ficha`) el contacto de la revision
#
# Carriles:
#   alta              crea el identificador de la app (Bundle ID) con la clave API y comprueba
#                     que la ficha existe en App Store Connect. La ficha («New App») la crea
#                     Jerome a mano una vez: la API de Apple no deja crearla, y produce
#                     (create_app_online) solo entra con Apple ID y verificacion en dos pasos.
#   subir_testflight  firma (match), archiva (gym) y sube a TestFlight (pilot). No se llama
#                     «testflight»: es el nombre de una accion de fastlane y lo avisa en rojo.
#   ficha       sube la ficha en las diez localizaciones y las capturas (deliver), sin el binario
#
# Nada aqui pulsa «Submit for Review»: eso lo hace Jerome en App Store Connect
# (o `deliver` con submit_for_review, cuando el lo diga).

default_platform(:ios)

APP_ID   = ENV["TGO_APP_ID"] || "tenerifego.app"
PROYECTO = "ios/App/App.xcodeproj"
ESQUEMA  = "App"
VERSION  = JSON.parse(File.read(File.expand_path("../package.json", __dir__)))["version"]

def clave_api
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: false,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Crea el identificador de Tenerife Go (Bundle ID) y comprueba que su ficha existe en App Store Connect. Una vez."
  lane :alta do
    # Con la clave API, la API oficial de App Store Connect: el Bundle ID si se
    # puede crear (bundleIds); la app no (no hay forma de crearla por la API, y
    # create_app_online entra con Apple ID, que un runner no tiene).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: clave_api)
    id = Spaceship::ConnectAPI::BundleId.find(APP_ID)
    if id
      UI.success("El identificador #{APP_ID} ya existe (#{id.name})")
    else
      id = Spaceship::ConnectAPI::BundleId.create(name: "Tenerife Go", platform: Spaceship::ConnectAPI::Platform::IOS, identifier: APP_ID)
      UI.success("Identificador creado: #{id.identifier}")
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    if app
      UI.success("La ficha de App Store Connect existe: «#{app.name}» (#{app.id}). Ya se puede lanzar «testflight».")
    else
      UI.user_error!("Falta la ficha en App Store Connect. Una vez, en appstoreconnect.apple.com → Apps → «+» → New App: " \
                     "iOS, nombre «Tenerife Go», Spanish (Spain), el Bundle ID #{APP_ID}, SKU «tenerife-go», acceso completo. " \
                     "Luego, otra vez «alta» para comprobarla (LANZAMIENTO-APP-STORE.md §9.1).")
    end
  end

  desc "Firma, archiva y sube a TestFlight"
  lane :subir_testflight do
    api_key = clave_api
    # El certificado de distribucion y el perfil: match los crea la primera vez
    # (con la clave API) y los guarda cifrados en MATCH_GIT_URL; despues, solo lee
    # (MATCH_READONLY=1 en el workflow, una vez creados). Se lee ANTES de
    # setup_ci, que lo pone a «true» por su cuenta.
    solo_leer = ENV["MATCH_READONLY"] == "1"
    # En CI (GitHub Actions pone CI=true), un llavero temporal para el
    # certificado: sin el, match y codesign pueden quedarse esperando al del
    # usuario. Fuera de CI no hace nada.
    setup_ci
    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: solo_leer,
      skip_docs: true
    )
    perfil = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")
    update_code_signing_settings(
      path: PROYECTO,
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: perfil
    )
    # La version, la de package.json; el numero de build, el de la ejecucion
    # de GitHub Actions (siempre mayor que el anterior: Apple exige que suba).
    # Van como ajustes de xcodebuild, sin tocar el proyecto (agvtool no hace falta).
    build = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    build_app(
      project: PROYECTO,
      scheme: ESQUEMA,
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => perfil }, signingStyle: "manual" },
      xcargs: "MARKETING_VERSION=#{VERSION} CURRENT_PROJECT_VERSION=#{build}",
      output_directory: "build",
      output_name: "TenerifeGo.ipa",
      clean: true
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Sube la ficha (diez localizaciones) y las capturas a App Store Connect, sin el binario"
  lane :ficha do
    api_key = clave_api
    revision = {}
    revision[:first_name]   = ENV["ASC_REVIEW_NAME"].split(" ").first if ENV["ASC_REVIEW_NAME"]
    revision[:last_name]    = ENV["ASC_REVIEW_NAME"].split(" ")[1..].join(" ") if ENV["ASC_REVIEW_NAME"]
    revision[:phone_number] = ENV["ASC_REVIEW_PHONE"] if ENV["ASC_REVIEW_PHONE"]
    revision[:email_address] = ENV["ASC_REVIEW_EMAIL"] if ENV["ASC_REVIEW_EMAIL"]
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: VERSION,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      app_review_information: revision,
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false }
    )
  end
end
